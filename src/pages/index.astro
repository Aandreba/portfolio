---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.tsx";
import ScrollSync from "../components/ScrollSync.tsx";
import ProjectCard from "../components/ProjectCard.astro";
import TalkItem from "../components/TalkItem.astro";
import PortalVisual from "../components/visuals/PortalVideo.astro";
import VgiVisual from "../components/visuals/VgiVisual.astro";
import ZigrcVisual from "../components/visuals/ZigrcVisual.astro";
import Wasm2spirvVisual from "../components/visuals/Wasm2spirvVisual.astro";
import BlazeVisual from "../components/visuals/BlazeVisual.astro";
import NesmuVisual from "../components/visuals/NesmuVideo.astro";
import { projects } from "../data/projects";
import { talks } from "../data/talks";
import AutoPlayVideo from "../components/AutoPlayVideo";
import { getRepoStats } from "../lib/githubStars";

// Maps each project's `name` to its side visual. Kept here (rather than in
// data/projects.ts) since these are Astro components, not serializable data.
const projectVisuals: Record<string, any> = {
    "Portal Ray Tracer": PortalVisual,
    vgi: VgiVisual,
    zigrc: ZigrcVisual,
    wasm2spirv: Wasm2spirvVisual,
    blaze: BlazeVisual,
    nesmu: NesmuVisual,
};

// Live star counts, fetched at build time (cached for a day — see
// src/lib/githubStars.ts). Also used to sort the project list, with the
// flagship project pinned to the top regardless of star count.
const GITHUB_REPO_URL = /^https:\/\/github\.com\/([^/]+)\/([^/]+)\/?$/;

const withStats = await Promise.all(
    projects.map(async (project) => {
        const match = project.href?.match(GITHUB_REPO_URL);
        if (!match) return { project, stars: -1 };

        const [, owner, repo] = match;
        const live = await getRepoStats(owner, repo);
        if (!live) return { project, stars: -1 };

        const forks = live.forks === 1 ? "1 fork" : `${live.forks} forks`;
        return { project, stats: `★ ${live.stars} · ${forks}`, stars: live.stars };
    }),
);

const pinned = withStats.filter((p) => p.project.badge?.flagship);
const rest = withStats
    .filter((p) => !p.project.badge?.flagship)
    .sort((a, b) => b.stars - a.stars);
const displayedProjects = [...pinned, ...rest];
---

<BaseLayout title="Alex Andreba — Systems & Graphics Programmer">
    <SiteHeader client:load />
    <ScrollSync client:load />

    <div class="hero">
        <div>
            <div class="eyebrow">Systems &amp; Graphics Developer</div>
            <h1>
                Alex Andreba<br />
            </h1>
            <p class="hero-desc">
                I'm a <b>systems programmer and graphics developer</b
                >&nbsp;working primarily in Rust, Zig, WGSL and OpenCL, with a
                focus on <b>GPU pipelines, compilers, and emulators</b>&nbsp;—
                the software layer closest to the hardware. I'm drawn to
                problems where performance and correctness are equally
                non-negotiable, from real-time rendering to bytecode and
                instruction-set translation.
            </p>
            <div class="hero-cta">
                <a
                    class="btn btn-primary"
                    href="https://github.com/Aandreba"
                    target="_blank"
                    rel="noopener"
                >
                    View GitHub →
                </a>
                <a class="btn btn-ghost" href="#talks">Watch the talks</a>
                <a
                    class="btn btn-ghost"
                    href="https://www.linkedin.com/in/alex-andreba/"
                    target="_blank"
                    rel="noopener"
                >
                    Connect on LinkedIn
                </a>
            </div>
            <div class="hero-meta">
                <div><strong>Based in</strong> Catalonia, Spain</div>
                <div><strong>Stack</strong> Rust · Zig · WGSL · Vulkan</div>
                <div>
                    <strong>Talks</strong> FOSDEM · OpenSouthCode · DORS/CLUC
                </div>
            </div>
        </div>

        <div class="viewport-wrap">
            <AutoPlayVideo src="ray-portal.mov" client:load />
        </div>
    </div>

    <section id="about">
        <div class="section-head">
            <h2 class="section-title">About Me</h2>
        </div>
        <div class="about-grid">
            <div>
                <p>
                    I'm a <b>systems programmer and graphics developer</b> working
                    across Rust, Zig, WGSL, WebAssembly and OpenCL. My work sits at
                    the boundary between hardware and higher-level code —&nbsp;
                    <b>GPU pipelines, compilers, and instruction sets</b> — the kind
                    of layer where correctness and performance both matter and neither
                    can be an afterthought.
                </p>
                <p>
                    I maintain a handful of open-source tools spanning graphics,
                    compilers, language runtimes and GPU tooling, and I've
                    spoken internationally about emulation and hardware
                    translation — most recently at <b>FOSDEM 2026</b> in Brussels.
                </p>
                <div class="focus-grid">
                    <div class="focus-card">
                        <div class="idx mono">FOCUS / 01</div>
                        <h3>GPU &amp; graphics programming</h3>
                        <p>
                            Vulkan &amp; wgpu, shader pipelines, acceleration
                            structures, real-time rendering.
                        </p>
                    </div>
                    <div class="focus-card">
                        <div class="idx mono">FOCUS / 02</div>
                        <h3>Compilers &amp; bytecode</h3>
                        <p>
                            WebAssembly → SPIR-V, dynamic recompilation,
                            instruction-set translation.
                        </p>
                    </div>
                    <div class="focus-card">
                        <div class="idx mono">FOCUS / 03</div>
                        <h3>Low-level systems</h3>
                        <p>
                            Rust &amp; Zig runtime internals, FFI, memory
                            models, GPU interop.
                        </p>
                    </div>
                </div>
            </div>
            <div>
                <div class="stack-title mono">TECH STACK</div>
                <div class="stack-list mono">
                    <span>Rust</span><span>Zig</span><span>WGSL</span><span
                        >Vulkan</span
                    >
                    <span>wgpu</span><span>OpenCL</span><span>WebAssembly</span
                    ><span>SPIR-V</span>
                    <span>ash</span><span>C++</span>
                </div>
            </div>
        </div>
    </section>

    <section id="projects">
        <div class="section-head">
            <h2 class="section-title">Projects</h2>
        </div>

        {
            displayedProjects.map(({ project, stats }) => {
                const Visual = projectVisuals[project.name];
                return (
                    <ProjectCard project={project} stats={stats}>
                        {Visual && <Visual slot="visual" />}
                    </ProjectCard>
                );
            })
        }
    </section>

    <section id="talks">
        <div class="section-head">
            <h2 class="section-title">Talks</h2>
        </div>
        <div class="talk-line">
            {talks.map((talk) => <TalkItem talk={talk} />)}
        </div>
    </section>

    <footer>
        <div class="f-left">
            <h2>Let's talk shop.</h2>
            <p>
                Open to conversations about ray tracing, compilers, or the next
                conference talk.
            </p>
        </div>
        <div class="f-links">
            <a
                class="btn btn-ghost"
                href="https://github.com/Aandreba"
                target="_blank"
                rel="noopener">GitHub ↗</a
            >
            <a
                class="btn btn-ghost"
                href="https://www.linkedin.com/in/alex-andreba/"
                target="_blank"
                rel="noopener">LinkedIn ↗</a
            >
        </div>
        <div class="f-copyright">
            <span>Alex Andreba — Catalonia, Spain</span>
        </div>
    </footer>
</BaseLayout>
