---
// Original animated illustration depicting bytecode translation:
// WASM opcodes flow along a path and resolve into a SPIR-V module.
---

<svg viewBox="0 0 240 180" xmlns="http://www.w3.org/2000/svg" class="pv-wasm2spirv" role="img" aria-label="Animated illustration of WebAssembly compiling into SPIR-V">
  <rect x="0" y="0" width="240" height="180" fill="#0e1119" />

  <rect x="20" y="66" width="64" height="48" rx="8" fill="#191d27" stroke="#7c8bff" stroke-width="2" />
  <text x="52" y="94" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" fill="#7c8bff">WASM</text>

  <rect x="156" y="66" width="64" height="48" rx="8" fill="#191d27" stroke="#ff8a5b" stroke-width="2" />
  <text x="188" y="90" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10.5" fill="#ff8a5b">SPIR-V</text>
  <text x="188" y="102" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="#ff8a5b" opacity="0.7">shader</text>

  <path id="w2s-path" d="M 84 90 L 156 90" stroke="#3a4150" stroke-width="2" fill="none" />

  <g font-family="JetBrains Mono, monospace" font-size="9" fill="#ffd166">
    <text x="0" y="0">
      <animateMotion dur="2.6s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
        <mpath href="#w2s-path" />
      </animateMotion>
      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="2.6s" repeatCount="indefinite" />
      0x2A
    </text>
  </g>
  <g font-family="JetBrains Mono, monospace" font-size="9" fill="#ffd166">
    <text x="0" y="0">
      <animateMotion dur="2.6s" begin="1.3s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
        <mpath href="#w2s-path" />
      </animateMotion>
      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.85;1" dur="2.6s" begin="1.3s" repeatCount="indefinite" />
      i32.add
    </text>
  </g>

  <rect x="20" y="130" width="200" height="4" rx="2" fill="#191d27" />
  <rect x="20" y="130" width="60" height="4" rx="2" fill="#7c8bff">
    <animate attributeName="width" values="0;200;0" dur="2.6s" repeatCount="indefinite" />
  </rect>
</svg>

<style>
  .pv-wasm2spirv {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
