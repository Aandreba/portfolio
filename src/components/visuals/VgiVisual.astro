---
// Original animated illustration depicting a thin Vulkan abstraction:
// calls descend from the app layer through VGI into the driver, while a
// double-buffered swapchain presents frames in the corner.
---

<svg viewBox="0 0 240 180" xmlns="http://www.w3.org/2000/svg" class="pv-vgi" role="img" aria-label="Animated illustration of application calls flowing through a thin Vulkan abstraction layer">
  <rect x="0" y="0" width="240" height="180" fill="#0e1119" />

  <rect x="85" y="16" width="70" height="26" rx="6" fill="#191d27" stroke="#3a4150" stroke-width="2" />
  <text x="120" y="34" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10.5" fill="#8991a3">app</text>

  <rect x="70" y="76" width="100" height="30" rx="6" fill="#191d27" stroke="#2dd4bf" stroke-width="2.5">
    <animate attributeName="stroke-opacity" values="0.55;1;0.55" dur="2s" repeatCount="indefinite" />
  </rect>
  <text x="120" y="96" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" fill="#2dd4bf">vgi</text>

  <rect x="60" y="138" width="120" height="26" rx="6" fill="#191d27" stroke="#3a4150" stroke-width="2" />
  <text x="120" y="155.5" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" fill="#8991a3">vulkan</text>

  <g stroke="#262b37" stroke-width="2" fill="none">
    <path d="M 120 42 L 120 76" />
    <path d="M 120 106 L 120 138" />
  </g>

  <g stroke="#2dd4bf" stroke-width="2.5" fill="none" stroke-dasharray="6 8">
    <path d="M 120 42 L 120 76">
      <animate attributeName="stroke-dashoffset" values="0;-28" dur="1.4s" repeatCount="indefinite" />
    </path>
    <path d="M 120 106 L 120 138">
      <animate attributeName="stroke-dashoffset" values="0;-28" dur="1.4s" begin="0.35s" repeatCount="indefinite" />
    </path>
  </g>

  <text x="200" y="12" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="8.5" fill="#8991a3">swapchain</text>
  <rect x="186" y="18" width="28" height="20" rx="3" fill="#191d27" stroke="#3a4150" stroke-width="1.5" />
  <rect x="190" y="22" width="28" height="20" rx="3" fill="#0e1119" stroke="#2dd4bf" stroke-width="1.5">
    <animate attributeName="opacity" values="1;0;1" dur="1.6s" repeatCount="indefinite" />
  </rect>
</svg>

<style>
  .pv-vgi {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
